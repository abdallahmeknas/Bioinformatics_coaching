// Use with nf-core (or any) pipelines inside a 2 core / 8 GB codespace:
//   nextflow run nf-core/demo -profile test,docker -c conf/codespaces.config --outdir results_nfcore
// Caps every task so nothing asks for more CPUs or memory than the machine has.
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 2.h ]
}
