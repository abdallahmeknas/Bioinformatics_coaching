// Configuration for the mini variant calling pipeline

params {
    samplesheet = "${projectDir}/data/mock/samplesheet.csv"
    reference   = "${projectDir}/data/mock/reference.fa"
    outdir      = "results"
}

// Sized for a 2 core / 8 GB codespace
process {
    cpus   = 1
    memory = 1.GB
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]

    withName: 'FASTQC|FASTP|BWA_MEM|SAMTOOLS_SORT' {
        cpus   = 2
        memory = 2.GB
    }
}

// Pick where the software comes from with -profile
profiles {

    // Default: use the tools already installed in the codespace (the "bioinfo" conda env)
    standard {
        process.executor = 'local'
    }

    // Nextflow creates a small conda environment for each process
    conda {
        conda.enabled  = true
        conda.useMamba = true
        process {
            withName: 'FASTQC'                                  { conda = 'bioconda::fastqc=0.12.1' }
            withName: 'FASTP'                                   { conda = 'bioconda::fastp=0.23.4' }
            withName: 'BWA_INDEX|BWA_MEM'                       { conda = 'bioconda::bwa=0.7.18' }
            withName: 'SAMTOOLS_SORT|SAMTOOLS_STATS|SAMTOOLS_FAIDX' { conda = 'bioconda::samtools=1.21' }
            withName: 'BCFTOOLS_CALL'                           { conda = 'bioconda::bcftools=1.20' }
            withName: 'MULTIQC'                                 { conda = 'bioconda::multiqc=1.25.1' }
        }
    }

    // Each process runs inside its own BioContainers image
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withName: 'FASTQC'                                  { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
            withName: 'FASTP'                                   { container = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0' }
            withName: 'BWA_INDEX|BWA_MEM'                       { container = 'quay.io/biocontainers/bwa:0.7.18--he4a0461_0' }
            withName: 'SAMTOOLS_SORT|SAMTOOLS_STATS|SAMTOOLS_FAIDX' { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' }
            withName: 'BCFTOOLS_CALL'                           { container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0' }
            withName: 'MULTIQC'                                 { container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0' }
        }
    }
}

// Handy run reports, written to results/pipeline_info
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
